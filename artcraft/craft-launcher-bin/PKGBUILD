# Maintainer: Sebastian Korotkiewicz <skorotkiewicz@gmail.com>
pkgname=craft-launcher-bin
_pkgname=${pkgname%-bin}
_distname=artcraft-launcher
pkgver=0.0.0
pkgrel=1
pkgdesc='Install, update and launch Craft apps (prebuilt binaries)'
arch=('x86_64' 'aarch64')
url="https://github.com/storytold/$_pkgname"
license=('MIT OR Apache-2.0' 'OFL-1.1' 'CC0-1.0' 'CC-BY-4.0' 'ISC'
         'Ubuntu-font-1.0' 'Bitstream-Vera' 'LicenseRef-ArtCraft-brand')
depends=('dbus' 'glibc>=2.35' 'hicolor-icon-theme' 'libgcc' 'libglvnd'
         'libx11' 'libxcursor' 'libxi' 'libxkbcommon' 'libxkbcommon-x11'
         'wayland')
depends_aarch64=('libxcb')
optdepends=('flatpak: install Craft apps')
optdepends_aarch64=('vulkan-icd-loader: GPU-accelerated rendering')
provides=("$_pkgname=$pkgver" "$_distname=$pkgver")
conflicts=("$_pkgname" "$_distname" "$_distname-git")
options=(!strip !debug)

_raw="https://raw.githubusercontent.com/storytold/$_pkgname/v$pkgver"
source=("$_pkgname-$pkgver-LICENSE-brand.txt::$_raw/docs/brand/LICENSE-brand.txt"
        "$_pkgname-$pkgver-OFL-Inter.txt::$_raw/assets/fonts/OFL-Inter.txt"
        "$_pkgname-$pkgver-OFL-Archivo.txt::$_raw/assets/fonts/OFL-Archivo.txt"
        "$_pkgname-$pkgver-OFL-GeistMono.txt::$_raw/assets/fonts/OFL-GeistMono.txt")
source_x86_64=("$url/releases/download/v$pkgver/$_distname-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/$_distname-$pkgver-linux-aarch64.tar.gz")
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP')
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  cd "$srcdir/$_distname-$pkgver-linux-$CARCH"

  install -Dm755 "bin/$_distname" "$pkgdir/usr/bin/$_distname"
  ln -s "$_distname" "$pkgdir/usr/bin/$_pkgname"
  cp -a --no-preserve=ownership share "$pkgdir/usr/"

  local _licenses="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 "share/doc/$_distname/"{LICENSE-APACHE,LICENSE-MIT,NOTICE} -t "$_licenses/"
  local _file
  for _file in LICENSE-brand.txt OFL-{Inter,Archivo,GeistMono}.txt; do
    install -Dm644 "$srcdir/$_pkgname-$pkgver-$_file" "$_licenses/$_file"
  done
}
