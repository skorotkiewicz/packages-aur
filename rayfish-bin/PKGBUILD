source_aarch64=("ray-linux-aarch64-$pkgver::$url/releases/download/v$pkgver/ray-linux-aarch64")

sha256sums_x86_64=('179de05afa0b627bd4098cde3e67371b330ab8b1742d24cf854a97a44ef850b3')
