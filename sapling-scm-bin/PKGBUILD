# Maintainer: Sebastian Korotkiewicz <skorotkiewicz@gmail.com>
pkgname=sapling-scm-bin
pkgver=0.2.20261103.145137+6282ac56
pkgrel=1
epoch=1
pkgdesc='Scalable, Git-compatible source control system (prebuilt binaries)'
arch=('x86_64' 'aarch64')
url='https://github.com/facebook/sapling'
license=('GPL-2.0-only' 'MIT')
depends=('glibc' 'gcc-libs' 'zlib' 'curl' 'nodejs')
optdepends=('git: Git repository support'
            'github-cli: GitHub integration'
            'watchman: faster file watching')
provides=('sapling-scm')
conflicts=('sapling-scm' 'sl')
options=(!strip !debug)

_tag="${pkgver%.*}-${pkgver##*.}"
source=("LICENSE::https://raw.githubusercontent.com/facebook/sapling/$_tag/LICENSE"
        "LICENSE-ISL::https://raw.githubusercontent.com/facebook/sapling/$_tag/addons/LICENSE")
source_x86_64=("sapling-$pkgver-linux-x64.tar.xz::$url/releases/download/$_tag/sapling-$_tag-linux-x64.tar.xz")
source_aarch64=("sapling-$pkgver-linux-arm64.tar.xz::$url/releases/download/$_tag/sapling-$_tag-linux-arm64.tar.xz")
sha256sums=('8177f97513213526df2cf6184d8ff986c675afb514d4e68a404010521b880643'
            '2d4c3d00d67067461412a2d9a2f3f8b7b9cda62b3db501e4b6844ccf35c949aa')
sha256sums_x86_64=('682f965b3abeae0a5ca0e1d64f35558679bad2fc79d5f6df34c7e82a52f9788c')
sha256sums_aarch64=('a8bb6388703c30630219933e482955faa33744cfb06bcd201910785cbe3c5749')

package() {
  install -d "$pkgdir/usr/lib/sapling-scm" "$pkgdir/usr/bin"
  cp -a --no-preserve=ownership "$srcdir/sl" "$srcdir/lib" "$srcdir/isl-dist.tar.xz" "$pkgdir/usr/lib/sapling-scm/"
  ln -s /usr/lib/sapling-scm/sl "$pkgdir/usr/bin/sl"
  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/LICENSE-ISL" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-ISL"
}
